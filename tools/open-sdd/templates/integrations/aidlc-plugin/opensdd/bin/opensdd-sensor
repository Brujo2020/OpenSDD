#!/bin/sh
# opensdd sensor runner for AI-DLC gates. Usage: opensdd-sensor <ears|constitution|boundary|gates> [feature]
# Fails closed when the open-sdd CLI cannot be found.
set -u
SENSOR="${1:-}"
FEATURE="${2:-${OPENSDD_FEATURE:-}}"
if [ -n "${OPEN_SDD_CLI:-}" ] && [ -f "$OPEN_SDD_CLI" ]; then RUN="node $OPEN_SDD_CLI"
elif command -v open-sdd >/dev/null 2>&1; then RUN="open-sdd"
else
  echo "opensdd-$SENSOR: FAIL — open-sdd CLI not found (set OPEN_SDD_CLI or npm install -D open-sdd)" >&2
  exit 1
fi
case "$SENSOR" in
  ears) [ -n "$FEATURE" ] || { echo "opensdd-ears: FAIL — no feature (OPENSDD_FEATURE)" >&2; exit 1; }; $RUN requirements review "$FEATURE" --no-footer ;;
  constitution) [ -n "$FEATURE" ] || { echo "opensdd-constitution: FAIL — no feature (OPENSDD_FEATURE)" >&2; exit 1; }; $RUN status "$FEATURE" --check --no-footer ;;
  boundary) $RUN govern discipline --no-footer ;;
  gates) $RUN gates run C1 C2 C3 --staged --strict --no-footer ;;
  *) echo "opensdd-sensor: unknown sensor «$SENSOR»" >&2; exit 2 ;;
esac
