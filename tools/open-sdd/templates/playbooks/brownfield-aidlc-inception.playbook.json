{
  "$schema": "./playbook.schema.json",
  "name": "brownfield-aidlc-inception",
  "description": "Recipe: AI-DLC inception on existing code, then steelfoundry delta, contracts and gates for construction.",
  "lead": "aidlc",
  "phases": [
    { "id": "inception", "steps": [{ "use": "aidlc:stage/reverse-engineering" }, { "use": "aidlc:stage/requirements-analysis", "review": "human" }, { "use": "aidlc:stage/units-generation" }] },
    { "id": "bridge", "steps": [{ "use": "opensdd:command/import-aidlc" }, { "use": "opensdd:command/delta-init" }, { "use": "opensdd:command/brownfield-constitution", "review": "human" }] },
    { "id": "build", "steps": [{ "use": "opensdd:skill/sdd-impl", "checks": ["opensdd:gates-c1-c3"] }, { "use": "opensdd:command/brownfield-contracts" }, { "use": "opensdd:skill/sdd-verify-completion", "review": "human" }] }
  ]
}
