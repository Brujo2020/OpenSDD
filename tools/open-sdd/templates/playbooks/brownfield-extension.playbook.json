{
  "name": "brownfield-extension",
  "description": "Change to running code with tests: the unit of change is the delta.",
  "lead": "opensdd",
  "phases": [
    {
      "id": "understand",
      "steps": [
        {
          "use": "opensdd:skill/sdd-getspecs"
        },
        {
          "use": "opensdd:command/brownfield-constitution",
          "review": "human"
        }
      ]
    },
    {
      "id": "specify",
      "steps": [
        {
          "use": "opensdd:command/delta-init"
        },
        {
          "use": "opensdd:skill/sdd-spec-tasks",
          "checks": [
            "opensdd:constitution"
          ],
          "review": "human"
        }
      ]
    },
    {
      "id": "build",
      "steps": [
        {
          "use": "opensdd:skill/sdd-impl",
          "checks": [
            "opensdd:gates-c1-c3"
          ]
        },
        {
          "use": "opensdd:command/brownfield-contracts"
        }
      ]
    }
  ]
}
