{
  "name": "multi-feature",
  "description": "A roadmap of dependent specs, generated by wave.",
  "lead": "opensdd",
  "phases": [
    {
      "id": "discover",
      "steps": [
        {
          "use": "opensdd:skill/sdd-discovery"
        }
      ]
    },
    {
      "id": "specify",
      "steps": [
        {
          "use": "opensdd:skill/sdd-spec-batch",
          "checks": [
            "opensdd:ears",
            "opensdd:constitution"
          ],
          "review": "human"
        }
      ]
    },
    {
      "id": "build",
      "steps": [
        {
          "use": "opensdd:command/waves"
        },
        {
          "use": "opensdd:skill/sdd-impl",
          "checks": [
            "opensdd:gates-c1-c3"
          ]
        },
        {
          "use": "opensdd:skill/sdd-validate-impl",
          "review": "human"
        }
      ]
    }
  ]
}
